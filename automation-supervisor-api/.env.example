# Supervisor 전용 설정. automation-supervisor-api 디렉터리에서 실행할 때 읽는다.

# automation 스키마만 접근하는 전용 계정 (V009에서 GRANT)
DATABASE_URL=postgresql+psycopg://supervisor_svc:change_me_supervisor_password@127.0.0.1:5432/portfolio

# anonymized 조회용. 메인 앱의 PORTFOLIO_AGENT_DATABASE_URL과 같은 값
PORTFOLIO_AGENT_DATABASE_URL=postgresql+psycopg://agent_svc:change_me_agent_password@127.0.0.1:5432/portfolio

# Celery 브로커. 메인 백엔드 워커와 큐가 섞이지 않도록 DB 인덱스를 분리한다.
REDIS_URL=redis://127.0.0.1:6379/3

API_PREFIX=/api/v1
MAX_QA_ITERATIONS=3

REQUIREMENT_ANALYSIS_MODEL=sonnet-4.6
DATA_SELECTION_MODEL=aws-nova
DATA_PROCESSING_MODEL=chatgpt-5.5

# provided=앞 단계가 넘긴 행 사용, database=anonymized 직접 조회
PIPELINE_QUERY_SOURCE=provided