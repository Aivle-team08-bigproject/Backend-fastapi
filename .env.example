POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=portfolio
POSTGRES_PORT=5432

AGENT_SVC_PASSWORD=change_me_agent_password
APP_SVC_PASSWORD=change_me_app_password
PORTFOLIO_ADMIN_PASSWORD=change_me_admin_password
PORTFOLIO_AGENT_DATABASE_URL=postgresql+psycopg://agent_svc:change_me_agent_password@127.0.0.1:5432/portfolio
PORTFOLIO_APP_DATABASE_URL=postgresql+psycopg://app_svc:change_me_app_password@127.0.0.1:5432/portfolio
PORTFOLIO_MIGRATION_DATABASE_URL=postgresql+psycopg://portfolio_admin:change_me_admin_password@127.0.0.1:5432/portfolio
SUPERVISOR_SVC_PASSWORD=change_me_supervisor_password

# 익명화 배치(scripts/anon_batch/fill_anon.py)가 식별자를 만들 때 쓴다.
# 값이 바뀌면 anonymized의 식별자가 전부 달라지므로 팀 내에서 동일해야 한다.
ANON_HASH_SALT=change_me_local_salt

# --- Celery / Redis 비동기 파이프라인 ---
# DB 0=브로커, 1=결과, 2=상태 이벤트로 분리해서 쓴다.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=false
WORKER_STATUS_REDIS_URL=redis://127.0.0.1:6379/2
WORKER_STATUS_CHANNEL=pipeline:run-status
WORKER_STATUS_SSE_CHANNEL=pipeline:run-status:persisted
WORKER_STATUS_KEY_PREFIX=pipeline:run-status:latest
WORKER_STATUS_TTL_SECONDS=86400

# --- 파일 업로드 ---
# 기본값(/app/uploads)은 컨테이너 경로다. 호스트에서 uvicorn을 직접 띄우면
# 쓰기 실패하므로 아래처럼 레포 내 경로로 바꿔둔다.
UPLOAD_ROOT=./uploads
CSV_UPLOAD_MAX_BYTES=52428800

# 데이터 선별 결과를 어디서 가져올지. csv=업로드 파일, database=anonymized 스키마
PIPELINE_QUERY_SOURCE=csv

# docker compose로 앱을 띄울 때만 db로 설정한다. 호스트 실행 시에는 비워둘 것.
DATABASE_HOST_OVERRIDE=

# docker compose 포트 (호스트에 이미 redis/uvicorn이 떠 있으면 바꿀 것)
REDIS_PORT=6379
API_PORT=8000

DASHBOARD_USD_TO_KRW_RATE=1330
DASHBOARD_TIMEZONE=Asia/Seoul

JWT_SECRET=local-only-random-jwt-secret-at-least-32-bytes-2026
JWT_ISSUER=portfolio-data-market
JWT_AUDIENCE=portfolio-operator-platform
ACCESS_TOKEN_TTL_MINUTES=10

SESSION_IDLE_TIMEOUT_MINUTES=10
SESSION_NORMAL_TTL_MINUTES=30
SESSION_REMEMBER_ME_TTL_HOURS=8
MAX_ACTIVE_SESSIONS=3
SESSION_ACTIVITY_TOUCH_INTERVAL_SECONDS=30

REFRESH_COOKIE_NAME=DM_REFRESH
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

BOOTSTRAP_ADMIN_ID=DEMO-ADMIN-001
BOOTSTRAP_ADMIN_PASSWORD=LocalAdmin!2026Secure
BOOTSTRAP_ADMIN_NAME=理쒖큹 愿由ъ옄
BOOTSTRAP_ADMIN_DEPARTMENT=IT愿由ы?


# --- 에이전트 LLM ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
REQUIREMENTS_ANALYSIS_MODEL_PROVIDER=deepseek
