FROM python:3.12-slim

WORKDIR /app

# AgentCore의 control-plane update가 환경 변수를 보고하더라도 컨테이너에
# 주입하지 않는 경우가 있어, 로컬 검증 Runtime의 DB secret ARN을 기본값으로 둔다.
# ARN은 비밀값이 아니며 실제 연결 문자열은 실행 역할로 Secrets Manager에서 읽는다.
ENV AGENT_DATABASE_SECRET_ARN=arn:aws:secretsmanager:ap-northeast-2:456375341833:secret:bigproject/local-dev/agentcore/neon-database-url-fqDmgf

COPY agent_runtime/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Runtime에는 소스만 넣는다. 로컬 dotenv/팀 환경 파일이 이미지 레이어에
# 포함되면 Neon 자격 증명이 ECR에 남을 수 있으므로 전체 작업 디렉터리를 복사하지 않는다.
COPY app ./app
COPY agent_runtime ./agent_runtime

RUN groupadd --system --gid 1000 appuser \
    && useradd --system --uid 1000 --gid 1000 --create-home appuser \
    && chown -R appuser:appuser /app

# 숫자 UID로 지정한다. AgentCore Runtime은 비숫자 USER 지시자와 레이어 수가 겹치면
# overlay 마운트에 실패하며 HTTP 424(Failed Dependency)를 돌려준다. 현재 이미지는
# 10 레이어라 한계(53)와 거리가 있지만, 조건 자체를 남겨둘 이유가 없다.
# 참고: https://docs.aws.amazon.com/bedrock-agentcore/latest/devguide/runtime-troubleshooting.html
USER 1000

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/ping', timeout=3)"

# AgentCore Runtime이 /ping과 /invocations를 호출한다.
CMD ["gunicorn", "app.agentcore_runtime:runtime_app", \
"--workers", "1", \
"--worker-class", "uvicorn.workers.UvicornWorker", \
"--timeout", "900", \
"--bind", "0.0.0.0:8080"]
